# Copy to .env for local development. NEVER commit the real .env.
# On Netlify, set these in Site configuration -> Environment variables instead.

NODE_ENV=development

# ---- Database (required) ---------------------------------------------------
# Any external PostgreSQL: Neon, Supabase, Railway, Render, Aiven, your own server ...
# On serverless prefer the provider's POOLED connection string (Neon "pooled", Supabase "pooler").
DATABASE_URL=postgres://dataverse:password@localhost:5432/dataverse
# auto = TLS for every non-local host | true | false
DATABASE_SSL=auto
# set to false only if your provider uses a self-signed certificate
DATABASE_SSL_REJECT_UNAUTHORIZED=true
# connections per instance (default: 1 on Netlify, 10 on a normal server)
# PG_POOL_MAX=

# ---- Security (required) ---------------------------------------------------
# At least 32 random characters:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-with-a-long-random-string-of-at-least-32-characters
JWT_EXPIRES_DAYS=7
BCRYPT_ROUNDS=12

# ---- URLs & CORS -----------------------------------------------------------
# Public URL of the site (used in password-reset emails)
SITE_URL=http://localhost:5173
# Comma-separated browser origins allowed to call the API from ANOTHER domain.
# Leave empty when the frontend and API share a domain (Netlify default / Vite proxy).
CORS_ORIGINS=
# Number of reverse proxies in front of the app (Express "trust proxy")
TRUST_PROXY=1

# ---- First administrator (bootstrap) ---------------------------------------
# Created by `npm run db:migrate` or `npm run admin:create` if no such user exists.
# Remove the password from the environment after the first run.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_NAME=Administrator
BOOTSTRAP_ADMIN_PASSWORD=change-this-long-password

# ---- Password-reset email (optional) ---------------------------------------
# Uses the Resend HTTP API. Without it, admins can still reset passwords from the Admin Panel.
RESEND_API_KEY=
MAIL_FROM=Dataverse <no-reply@yourdomain.com>

# ---- Normal Node server only (VPS / Docker) --------------------------------
PORT=3001
# Serve the built React app from the same Express process
SERVE_FRONTEND=false
