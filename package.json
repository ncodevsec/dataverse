{
  "name": "dataverse",
  "version": "1.0.0",
  "private": true,
  "description": "Dataverse - family profiles, Shekor family tree and Caller ID",
  "type": "module",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c green,cyan \"npm run dev -w backend\" \"npm run dev -w frontend\"",
    "build": "npm run build -w frontend",
    "start": "npm run start -w backend",
    "db:migrate": "node backend/scripts/migrate.js",
    "db:import": "node backend/scripts/import-legacy.js",
    "admin:create": "node backend/scripts/create-admin.js",
    "test": "npm run test -w backend",
    "lint:check": "npm run check -w backend",
    "backup": "node backend/scripts/backup.js"
  },
  "devDependencies": {
    "concurrently": "^9.0.1"
  },
  "dependencies": {
    "serverless-http": "^3.2.0"
  }
}
